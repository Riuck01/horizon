---
/**
 * * Hero with background image
 * You'll want a mobile image, and a desktop image for this.
 */

import Button from "@components/Button/Button.astro";
import heroImage from "@images/hero-bg-min.jpg";
import heroImageMobile from "@images/hero-bg-min.jpg";
import logo from "@images/site-logo.png";
import { Image } from "astro:assets";
---

<section id="hero" class="relative z-10 flex min-h-[100lvh] w-full">
    <!-- background image -->
    <div class="absolute -z-10 h-full min-h-full w-full overflow-hidden">
        <div class="absolute inset-0 bg-black/20"></div>

        <Image
            src={heroImage}
            class="hidden h-auto min-h-full w-full object-cover object-bottom sm:block"
            alt="wedding"
            aria-hidden="true"
            loading="eager"
            height={1400}
        />
        <Image
            src={heroImageMobile}
            class="h-auto min-h-full w-full object-cover sm:hidden"
            alt="wedding"
            aria-hidden="true"
            loading="eager"
            width={1200}
        />
    </div>

    <!-- hero items -->
    <div class="site-container relative w-full gap-10 py-44 text-center md:py-52 md:text-left">
        <!-- Hero content -->
        <div class="text-base-50 my-auto mr-auto max-w-[900px] flex flex-col items-center md:items-start p-6 md:p-0 rounded-3xl md:bg-transparent">
            
            <!-- Logo uniquement visible sur mobile (masqué sur PC avec md:hidden) -->
            <div class="mb-6 md:hidden">
                <Image
                    src={logo}
                    alt="Forest Events"
                    loading="eager"
                    width={500}
                    class="h-44 sm:h-56 w-auto object-contain drop-shadow-[0_6px_10px_rgba(0,0,0,0.8)]"
                />
            </div>

            <!-- DJ Tom Forest -->
            <h1
                class="font-heading-1 text-4xl sm:text-5xl md:text-7xl font-semibold text-pretty drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] leading-tight mb-8"
            >
                DJ Tom Forest
            </h1>

            <p
                class="text-lg tracking-widest text-pretty drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)] md:max-w-[550px] md:text-2xl"
            >
                Des émotions, du rythme, une soirée inoubliable, mais encore et surtout. Un mariage qui vous ressemble.
            </p>
        </div>
    </div>
</section>