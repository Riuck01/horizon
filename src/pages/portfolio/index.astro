---
import BaseLayout from "@layouts/BaseLayout.astro";

// Récupère toutes les images dans src/assets/gallery
const imageModules = import.meta.glob("../assets/gallery/*.{jpg,jpeg,png,webp}", { eager: true });

// Transforme les modules en URLs
const images = Object.values(imageModules).map((mod: any) => mod.default);
---

<BaseLayout title="Galerie images" description="Toutes les images de mon dossier">
  <section class="site-container pt-24 md:pt-36">
    <div class="mx-auto max-w-6xl text-center mb-12">
      <h1 class="text-5xl font-bold">Galerie images</h1>
      <p class="text-lg text-gray-600 mt-4">Toutes les images en un seul endroit.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {images.map((src) => (
        <div class="overflow-hidden rounded-lg">
          <img src={src} alt="Image" class="w-full h-full object-cover" />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
